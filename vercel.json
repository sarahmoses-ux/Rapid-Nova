{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm ci --prefix backend --omit=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "excludeFiles": "{backend/data/**,backend/tests/**,backend/.env*,tests/**,test-results/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__route=:path*" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" },
    { "source": "/careers/:path*", "destination": "/index.html" },
    { "source": "/international-nursing/:path*", "destination": "/index.html" },
    { "source": "/staffing/:path*", "destination": "/index.html" },
    { "source": "/about/:path*", "destination": "/index.html" },
    { "source": "/resources/:path*", "destination": "/index.html" },
    { "source": "/apply/:path*", "destination": "/index.html" },
    { "source": "/contact/:path*", "destination": "/index.html" }
  ]
}
