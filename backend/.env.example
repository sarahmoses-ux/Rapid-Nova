PORT=3001
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=rapid_nova
# For Atlas, replace MONGODB_URI in backend/.env with your private connection string.
# Never commit real credentials or put them in this example file.
DATA_DIR=./data
# Relative DATA_DIR paths resolve from the backend folder.
# Production: NODE_ENV=production, HOST=0.0.0.0 and the exact HTTPS origin.
# DATA_DIR stores local admin credentials, not application records or CVs.
# NODE_ENV=production
# PUBLIC_ORIGIN=https://your-domain.example
# Optional environment credentials instead of npm run admin:setup:
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=