{
  "name": "rapid-nova-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "admin:setup": "node --env-file-if-exists=.env src/setup-admin.js",
    "test": "node --test tests/*.test.js",
    "migrate:sqlite": "node --env-file-if-exists=.env src/migrate-sqlite.js"
  },
  "dependencies": {
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
